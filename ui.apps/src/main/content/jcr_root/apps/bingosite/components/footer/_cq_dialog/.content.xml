<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Bingo Footer Component"
    sling:resourceType="cq/gui/components/authoring/dialog"
    extraClientlibs="[core.wcm.components.title.v2.editor]"
    trackingFeature="core-components:title:v3">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <footer
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Footer"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <itclogo
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                    rootPath="/content/dam/bingosite"
                                                    fieldDescription="ITC logo from DAM"
                                                    fieldLabel="ITC Logo"
                                                    name="./itclogo">
                                            </itclogo>
                                            <fssailicense
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                    rootPath="/content/dam/bingosite"
                                                    fieldDescription="FSSAI License image path from DAM"
                                                    fieldLabel="FSSAI License"
                                                    name="./license">
                                            </fssailicense>
                                            <upperFooter
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                fieldDescription="Upper Footer Options"
                                                fieldLabel="Upper Footer Options"
                                                composite="{Boolean}true">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                    name="./upperfooter">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <upperFooterText
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldDescription="Upper Footer Text"
                                                            fieldLabel="Upper Footer Text"
                                                            name="./upperfootertext"/>
                                                        <upperFooterRedURL
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                fieldDescription="Upper Footer Redirect URL"
                                                                fieldLabel="Upper Footer Redirect URL"
                                                                name="./upperfooterredurl"/>
                                                    </items>
                                                </field>
                                            </upperFooter>

                                            <lowerFooter
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                    fieldDescription="Lower Footer Options"
                                                    fieldLabel="Lower Footer Options"
                                                    composite="{Boolean}true">
                                                <field
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/container"
                                                        name="./lowerfooter">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <lowerFooterText
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                fieldDescription="Lower Footer Text"
                                                                fieldLabel="Lower Footer Text"
                                                                name="./lowerfootertext"/>
                                                        <lowerFooterRedURL
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                fieldDescription="Lower Footer Redirect URL"
                                                                fieldLabel="Lower Footer Redirect URL"
                                                                name="./lowerfooterredurl"/>
                                                    </items>
                                                </field>
                                            </lowerFooter>

                                            <lowerFooterSocialMedia
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                    fieldDescription="Lower Footer Social Media Options"
                                                    fieldLabel="Lower Footer Social Media Options"
                                                    composite="{Boolean}true">
                                                <field
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/container"
                                                        name="./lowerfootersm">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <lowerFooterSMlogo
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                                rootPath="/content/dam/bingosite"
                                                                fieldDescription="Lower Footer Social Media Logo"
                                                                fieldLabel="Lower Footer Social Media Logo"
                                                                name="./lowerfootersmlogo"/>
                                                        <upperFooterRedURL
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                fieldDescription="Lower Footer Social Media Redirect URL"
                                                                fieldLabel="Lower Footer Social MediaRedirect URL"
                                                                name="./lowerfootsmredurl"/>
                                                    </items>
                                                </field>
                                            </lowerFooterSocialMedia>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </footer>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
